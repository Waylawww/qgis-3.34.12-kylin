# ============================================================================
# QGIS 3.34.12 依赖矩阵 —— 银河麒麟 V10 (Halberd) / x86_64 / glibc 2.28
# 依据：目标主机 2026-11-13 真实探测 (probe-env.json) + QGIS final-3_34_12
#       CMakeLists.txt 的 REQUIRED 依赖清单。
# 修订：依据真实失败 run 43358840843 的 dep-*.log 与本地对上游归档的实测，
#       修正版本、URL、路径假设；每条结论都来自实际 HTTP/归档检查。
#
# 统一安装前缀 : $DEPS_PREFIX（runner.workspace 下持久化目录，actionsrunner 可写）
# 系统库策略   : 不写入 /usr；系统自带 Qt5.11.1/PROJ4.9.3/GEOS3.6.1 一律不覆盖。
#               系统 DEVEL RPM 只下载并解压到 $DEPS_PREFIX/sysroot，不安装。
# 运行期       : CMAKE_INSTALL_RPATH 指向 $DEPS_PREFIX/lib，
#               打包阶段再改写到 RPM 内的 /usr/lib64/qgis-3.34-deps。
# ============================================================================

DEPS_TARGET_GLIBC=2.28
DEPS_TARGET_PYTHON=3.7.9
DEPS_TARGET_GCC=11.5.0
DEPS_TARGET_ISA="x86-64-baseline"

# --- Qt 5.15.2 -------------------------------------------------------------
# 上游: https://download.qt.io/archive/qt/5.15/5.15.2/single/
# 依赖: 系统 libxcb / X11 / freetype / fontconfig / mesa-libGL（头文件或 sysroot）
# 参数: -opensource -confirm-license -release -shared -nomake examples/tests
#       -qt-xcb -qt-pcre -qt-doubleconversion -qt-harfbuzz -qt-libpng
#       -qt-libjpeg -qt-zlib -system-freetype -fontconfig -openssl -no-icu
#       -skip qtwebengine -skip qtdoc -skip qtwayland
#       （qtbase / qtsvg / qtlocation / qttools / qt3d / qtdeclarative 必须编入：
#         QGIS 需要 Qt5 Positioning、Test、Sql、PrintSupport 与 3DCore..3DExtras）
# 验证: $DEPS_PREFIX/bin/qmake -v ; ls $DEPS_PREFIX/lib/cmake/Qt53DCore
# 实测：download.qt.io 传了 36 分钟后 curl(18) 中断，清华镜像可完整下载，
#       故国内镜像优先；Qt bootstrap 的 qmake 还需要 GCC11 的 libstdc++。
QT_VERSION=5.15.2
QT_TARBALL=qt-everywhere-src-5.15.2.tar.xz
QT_URLS=(
  'https://mirrors.tuna.tsinghua.edu.cn/qt/archive/qt/5.15/5.15.2/single/qt-everywhere-src-5.15.2.tar.xz'
  'https://mirrors.ustc.edu.cn/qtproject/archive/qt/5.15/5.15.2/single/qt-everywhere-src-5.15.2.tar.xz'
  'https://download.qt.io/archive/qt/5.15/5.15.2/single/qt-everywhere-src-5.15.2.tar.xz'
)

# --- PROJ 8.2.1 (>=7.2) ---------------------------------------------------
# 上游: https://download.osgeo.org/proj/proj-8.2.1.tar.gz
# 依赖: sqlite3 >=3.11（系统 3.32.3 满足），TIFF/CURL 可选关闭
# 参数: -DBUILD_TESTING=OFF -DENABLE_TIFF=OFF -DENABLE_CURL=OFF
# 验证: $DEPS_PREFIX/bin/proj 2>&1 | head -1 ; pkg-config --modversion proj
# 实测：CMake 默认装到 lib64/，校验必须同时看 lib/ 与 lib64/。
PROJ_VERSION=8.2.1
PROJ_TARBALL=proj-8.2.1.tar.gz
PROJ_URLS=('https://download.osgeo.org/proj/proj-8.2.1.tar.gz'
           'https://github.com/OSGeo/PROJ/archive/refs/tags/8.2.1.tar.gz')

# --- GEOS 3.10.3 (>=3.9) --------------------------------------------------
# 上游: https://download.osgeo.org/geos/geos-3.10.3.tar.bz2
# 依赖: 无外部依赖（C++14）
# 参数: -DBUILD_TESTING=OFF -DBUILD_SHARED_LIBS=ON -DBUILD_GEOSOP=OFF
# 验证: $DEPS_PREFIX/bin/geos-config --version ; pkg-config --modversion geos
GEOS_VERSION=3.10.3
GEOS_TARBALL=geos-3.10.3.tar.bz2
GEOS_URLS=('https://download.osgeo.org/geos/geos-3.10.3.tar.bz2'
           'https://github.com/libgeos/geos/archive/refs/tags/3.10.3.tar.gz')

# --- GDAL 3.5.3 (>=3.2) ---------------------------------------------------
# 重要实测（2026-11-13）：GDAL 3.4.3 的官方发布包（4519 个成员）与
# GitHub tag archive（8963 个成员）都是 autotools `make dist` 产物，
# **完全不含 CMakeLists.txt / cmake/**，因此根本无法 cmake -S 配置。
# 3.5.3 / 3.6.4 的发布包实测带 gdal-3.5.3/CMakeLists.txt + cmake/，
# 故选 3.5.3（QGIS 3.34.12 的 find_package(GDAL REQUIRED) 无高版本限制）。
# 上游: https://download.osgeo.org/gdal/3.5.3/gdal-3.5.3.tar.gz
# 依赖: PROJ 8.2.1 + GEOS 3.10.3 + sqlite3 + zlib + expat + TIFF/JPEG/PNG
# 参数: 关闭可选驱动与语言绑定，避免 sysroot 中断链 .so 干扰
# 验证: $DEPS_PREFIX/bin/gdalinfo --version
GDAL_VERSION=3.5.3
GDAL_TARBALL=gdal-3.5.3.tar.gz
GDAL_URLS=('https://download.osgeo.org/gdal/3.5.3/gdal-3.5.3.tar.gz'
           'https://codeload.github.com/OSGeo/gdal/tar.gz/refs/tags/v3.5.3'
           'https://github.com/OSGeo/gdal/archive/refs/tags/v3.5.3.tar.gz')

# --- 其余 QGIS REQUIRED 依赖 ----------------------------------------------
# 全部安装到同一前缀；fetch_source() 会按 URL 逐个尝试并校验归档内容，
# cmake_install()/installed_lib() 统一处理 lib/ 与 lib64/ 两种布局。
SPATIALINDEX_VERSION=1.9.3
SPATIALINDEX_URLS=('https://github.com/libspatialindex/libspatialindex/archive/refs/tags/1.9.3.tar.gz'
                   'https://download.osgeo.org/libspatialindex/spatialindex-src-1.9.3.tar.bz2')

LIBZIP_VERSION=1.9.2
LIBZIP_URLS=('https://github.com/nih-at/libzip/archive/refs/tags/v1.9.2.tar.gz'
             'https://libzip.org/download/libzip-1.9.2.tar.xz')

EXIV2_VERSION=0.27.5
EXIV2_URLS=('https://github.com/Exiv2/exiv2/archive/refs/tags/v0.27.5.tar.gz')

QWT_VERSION=6.1.6
QWT_URLS=('https://sourceforge.net/projects/qwt/files/qwt/6.1.6/qwt-6.1.6.tar.bz2/download'
          'https://downloads.sourceforge.net/project/qwt/qwt/6.1.6/qwt-6.1.6.tar.bz2')

# QScintilla 2.13.3 归档实测结构：顶层没有 Qt4Qt5/，
# 库源码在 src/qscintilla.pro，头文件在 src/Qsci/，sip 文件在 Python/sip/。
QSCINTILLA_VERSION=2.13.3
QSCINTILLA_URLS=('https://www.riverbankcomputing.com/static/Downloads/QScintilla/2.13.3/QScintilla_src-2.13.3.tar.gz')

QCA_VERSION=2.3.5
QCA_URLS=('https://github.com/KDE/qca/archive/refs/tags/v2.3.5.tar.gz'
          'https://download.kde.org/stable/qca/2.3.5/qca-2.3.5.tar.xz')

# 实测：v0.13.2 tag 存在、codeload 返回 200；github.com archive 在 runner 上
# 曾瞬时失败，故加 codeload 与代理备用。
QTKEYCHAIN_VERSION=0.13.2
QTKEYCHAIN_URLS=('https://codeload.github.com/frankosterfeld/qtkeychain/tar.gz/refs/tags/v0.13.2'
                 'https://github.com/frankosterfeld/qtkeychain/archive/refs/tags/v0.13.2.tar.gz'
                 'https://ghproxy.net/https://github.com/frankosterfeld/qtkeychain/archive/refs/tags/v0.13.2.tar.gz')

# SIP 4 实测：/static/Downloads/sip/4.19.25/sip-4.19.25.tar.gz 返回 206；
# 旧值 /sip/4/... 是 404；PyPI 没有 sip 4.x（最低 5.0.0），不能用 pip 兜底。
SIP_VERSION=4.19.25
SIP_URLS=('https://www.riverbankcomputing.com/static/Downloads/sip/4.19.25/sip-4.19.25.tar.gz')

# PyQt5 5.15.6：Riverbank 的 PyQt5-*.tar.gz / PyQt5_gpl-*.tar.gz 与
# SourceForge 镜像均 404，PyPI sdist 是唯一可用源码。
# 实测该 sdist 自带传统 configure.py（SIP_MIN_VERSION='4.19.23'，代码里
# 明确区分 sip v4/v5）、887 个 .sip 文件含 sip/QtCore/QtCoremod.sip，
# 支持 --no-designer-plugin/--no-qml-plugin/--no-tools，
# 因此可与 SIP 4.19.25 用 configure.py 传统方式构建，不走 pip/PEP517
# （旧的 pip fallback 报 sipbuild.api has no attribute prepare_metadata...）。
PYQT5_VERSION=5.15.6
PYQT5_URLS=('https://files.pythonhosted.org/packages/3b/27/fd81188a35f37be9b3b4c2db1654d9439d1418823916fe702ac3658c9c41/PyQt5-5.15.6.tar.gz'
            'https://pypi.org/packages/source/P/PyQt5/PyQt5-5.15.6.tar.gz')

# --- 系统 DEVEL RPM（只下载解压，不安装、不 sudo） -------------------------
# 目的：补齐 X11/xcb/openssl/TIFF/JPEG/PNG/CURL/EXPAT/ZLIB/libxml2/sqlite 等
# 头文件与库，供 Qt configure、GDAL、QCA 使用。
SYSROOT_DEVEL_RPMS=(
  libX11-devel libXext-devel libXi-devel libXrender-devel libxcb-devel
  xcb-util-devel xcb-util-image-devel xcb-util-renderutil-devel
  xcb-util-wm-devel xcb-util-keysyms-devel
  libxkbcommon-devel libxkbcommon-x11-devel
  mesa-libGL-devel mesa-libEGL-devel libglvnd-devel
  openssl-devel libjpeg-turbo-devel libpng-devel zlib-devel
  libtiff-devel libcurl-devel expat-devel libxml2-devel
  sqlite-devel postgresql-devel gsl-devel
  protobuf-devel protobuf-compiler exiv2-devel libzip-devel
  freexl-devel
  freetype-devel fontconfig-devel glib2-devel dbus-devel
  pcre2-devel zstd-devel harfbuzz-devel
  libgeotiff-devel
)
# 实测 dep-sysroot.log：下面三个包在麒麟 V10 源里不存在，已移除：
#   libspatialindex-devel —— spatialindex 由本脚本源码构建
#   double-conversion-devel —— Qt 使用 -qt-doubleconversion 自带实现
#   icu-devel —— Qt configure 加 -no-icu
