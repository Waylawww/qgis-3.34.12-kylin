# Windows 开发 + Linux 容器执行：强制所有文本以 LF 入库 / 检出。
# 防止 core.autocrlf=true 把 \r 带进 bash 脚本、Dockerfile、SPEC、YAML。
* text=auto eol=lf

*.sh            text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.env           text eol=lf
*.example       text eol=lf
*.tsv           text eol=lf
*.in            text eol=lf
*.inc           text eol=lf
*.tpl           text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
*.json          text eol=lf
*.cfg           text eol=lf
Makefile        text eol=lf
Dockerfile*     text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf

# 二进制产物不做行尾转换
*.png           binary
*.rpm           binary
*.qcow2         binary
*.iso           binary
*.tar.bz2       binary
*.gz            binary
