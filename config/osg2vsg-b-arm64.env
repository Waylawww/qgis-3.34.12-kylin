# osg2vsg 0.4.0 · Kylin V10 (Lance) / aarch64 / Hi1616 原生构建参数
# B 设备专用：由 .github/workflows/osg2vsg-b-arm64.yml 通过 BUILD_ENV 注入。
# 版本/commit 与 A 设备完全一致（官方固定 commit），仅覆盖平台/ISA/运行库
# 以及 B 设备已产出的依赖前缀（vsg / glslang）。

OSG2VSG_VERSION=0.4.0
OSG2VSG_TAG=v0.4.0
OSG2VSG_REPO=https://github.com/vsg-dev/osg2vsg
OSG2VSG_COMMIT=8494fc6cb25d8d74cc41a8737f77e8a639ea39fb

VSG_VERSION=1.1.13
VSG_TAG=v1.1.13
VSG_REPO=https://github.com/vsg-dev/VulkanSceneGraph
VSG_COMMIT=05bb15b50fbfe1056f9d8d2ef8a83060e68ad66d

OSG_VERSION=3.6.5
OSG_TAG=OpenSceneGraph-3.6.5
OSG_REPO=https://github.com/openscenegraph/OpenSceneGraph
OSG_COMMIT=a827840baf0786d72e11ac16d5338a4ee25779db

VULKAN_HEADERS_COMMIT=881bbb347a08d1b5aa77f61a52a30b506de9f2bf
VULKAN_HEADERS_LABEL=1.2.131

OSG2VSG_INSTALL_PREFIX=/opt/osg2vsg-0.4.0
VSG_INSTALL_PREFIX=/opt/vsg-1.1.13
OSG_INSTALL_PREFIX=/opt/osg-3.6.5
OSG2VSG_BUILD_JOBS_DEFAULT=6
OSG2VSG_BUILD_WERROR=OFF
OSG2VSG_MIN_CMAKE=3.16

# ---- B 设备平台参数 ----
TARGET_OS=Kylin-Server-V10-Lance
TARGET_ARCH=aarch64
TARGET_CPU=Hi1616-64bit
ISA_CFLAGS="-march=armv8-a -O2 -pipe"
ISA_CXXFLAGS="-march=armv8-a -O2 -pipe"
ISA_POLICY=aarch64-armv8a-baseline
# B 设备使用系统 GCC7 全链编译，不打包私有 libstdc++
REQUIRE_GCC11=false

# B 设备已产出的 glslang（用于 VSG 着色器编译）本地安装前缀；
# 为空时 build 脚本会跳过 glslang 库合包（仅影响可选着色器能力）。
B_GLSLANG_PREFIX=/opt/actions-runner/_work/qgis-3.34.12-kylin/_b-glslang-1610-work/local-install/opt/glslang-16.1.0
