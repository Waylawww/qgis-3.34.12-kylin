# VulkanSceneGraph 1.1.13 · Kylin V10 / x86_64 / Hygon C86 原生构建
# 与 qgis / assimp / glslang / osg2vsg / rocky 共用同一台 self-hosted runner。

VSG_VERSION=1.1.13
VSG_SOVERSION=15
VSG_REPO=https://github.com/vsg-dev/VulkanSceneGraph
VSG_COMMIT=05bb15b50fbfe1056f9d8d2ef8a83060e68ad66d
VSG_INSTALL_PREFIX=/opt/vsg-1.1.13

# 系统 vulkan-headers 1.1.92 与 VSG 1.1.13 兼容层冲突，使用固定 1.2.131 头文件。
VULKAN_HEADERS_COMMIT=881bbb347a08d1b5aa77f61a52a30b506de9f2bf
VULKAN_HEADERS_LABEL=1.2.131

# 复用已安装的 glslang 16.1.0；关闭 SPIR-V optimizer 以避免 SPIRV-Tools-opt 依赖。
GLSLANG_PREFIX=/opt/glslang-16.1.0
VSG_SUPPORTS_ShaderCompiler=ON
VSG_SUPPORTS_ShaderOptimizer=OFF
VSG_SUPPORTS_Windowing=ON

VSG_MIN_CMAKE=3.16
