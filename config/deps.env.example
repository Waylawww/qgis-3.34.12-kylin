# ============================================================================
# 【必须确认】麒麟 V10 原生 RPM 依赖映射
# 本文件仅作格式示例。真实内容由 `python3 scripts/probe-kylin.py --write` 在
# 麒麟 V10 容器内依据 `dnf/yum repoquery --whatprovides` 实际探测后生成，
# 输出为 config/deps.confirmed.env（不入库）。
#
# 严禁把 Ubuntu/Debian 包名或版本号写进来；严禁把 Ubuntu 编译产物打进 RPM。
# ============================================================================

# 探测时间与宿主标识（由脚本填写）
DEPS_PROBED_AT=__UNCONFIRMED__
DEPS_PROBE_OS=__UNCONFIRMED__
DEPS_PROBE_PM=__UNCONFIRMED__

# 每个能力键对应一个真实存在的麒麟 RPM 包名
# 示例（Fedora 风格，仅为「候选名」，必须以麒麟实测结果为准）：
# DEP_CMAKE=cmake
# DEP_GDAL=gdal-devel
# DEP_QT5CORE=qt5-qtbase-devel
QGIS_BUILDREQUIRES=__UNCONFIRMED__
QGIS_RUNTIME_REQUIRES=__UNCONFIRMED__
UNRESOLVED_DEPS=__UNCONFIRMED__
DEPS_VERSION_FAILURES=__UNCONFIRMED__
