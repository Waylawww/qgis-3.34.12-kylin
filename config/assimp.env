# Assimp 6.0.5 · Kylin V10 (Halberd) / x86_64 / Hygon C86 原生构建参数
# 与 QGIS 工程共用同一台 self-hosted runner，但不写入 /usr、不覆盖系统库。
# 所有字段均来自本地锁定源码 libs/assimp-10.19（tag v6.0.5）实测。

ASSIMP_VERSION=6.0.5
ASSIMP_VERSION_MAJOR=6
ASSIMP_TAG=v6.0.5
ASSIMP_UPSTREAM_REPO=https://github.com/assimp/assimp
ASSIMP_GIT_COMMIT=392a658f9c271be965271f45e7521a1b80ea4392
# 本地工作副本相对 v6.0.5 的改动（OBJ 进度回调 / 解析健壮性等），必须随源码一起应用
ASSIMP_PATCH_REL=patches/assimp-6.0.5-kylin.patch
ASSIMP_PATCH_SHA256=7355dcd16290a487c0b0bd368b942d8ec440295f902354554885389e2b3e203c

# RPM 内安装前缀；测试时从 RPM 解包到独立目录，避免依赖构建机路径
ASSIMP_INSTALL_PREFIX=/opt/assimp-6.0.5

# 构建选项（与 AGENTS.md 推荐一致，但关闭 Werror 以兼容麒麟 GCC）
ASSIMP_BUILD_TESTS=ON
ASSIMP_BUILD_TOOLS=ON
ASSIMP_BUILD_SAMPLES=OFF
ASSIMP_WARNINGS_AS_ERRORS=OFF
ASSIMP_BUILD_SHARED=ON
ASSIMP_MIN_CMAKE=3.22.0
# CMake 3.28.3 仅在系统 cmake 过旧时源码构建到私有 tools 目录
ASSIMP_BOOTSTRAP_CMAKE_VERSION=3.28.3
