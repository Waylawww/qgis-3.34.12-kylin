# ============================================================================
# 已核验事实（来自 QGIS 官方仓库，非猜测）—— 请勿修改
# 核验时间：2026-11-12
# 来源：
#   https://api.github.com/repos/qgis/QGIS/git/ref/tags/final-3_34_12
#   https://api.github.com/repos/qgis/QGIS/git/tags/526ce8a48f32b31ec03efec74407f3da25c858a0
#   https://raw.githubusercontent.com/qgis/QGIS/final-3_34_12/CMakeLists.txt
#   https://raw.githubusercontent.com/qgis/QGIS/release-3_34/INSTALL.md
#   https://raw.githubusercontent.com/qgis/QGIS/final-3_34_12/rpm/qgis.spec.template
#   https://raw.githubusercontent.com/qgis/QGIS/final-3_34_12/rpm/buildrpms.sh
# ============================================================================

# 严格锁定 3.34.12；任何脚本都会再次校验 CMakeLists 中的 3/34/12
QGIS_VERSION=3.34.12
QGIS_RELEASE_NAME=Prizren
QGIS_GIT_REPO=https://github.com/qgis/QGIS.git
QGIS_GIT_TAG=final-3_34_12
# 带注释 tag 对象 526ce8a48f32b31ec03efec74407f3da25c858a0 指向的 commit
QGIS_GIT_COMMIT=eeb6af363865e463b8f058b7d79fd5378c4bf065
# 官方 rpm/buildrpms.sh 使用 `git archive --prefix=qgis-$version/`，此处保持一致
QGIS_SOURCE_DIR_NAME=qgis-3.34.12
QGIS_SOURCE_TARBALL=qgis-3.34.12.tar.bz2
QGIS_RELEASE_TAG_FOR_GITHUB=v3.34.12-kylin10

# 官方 INSTALL.md / CMakeLists.txt 中的硬下限（详见 config/capabilities.tsv）
QGIS_CMAKE_MIN=3.12.0
QGIS_FLEX_MIN=2.6.0
QGIS_QT5_MIN=5.14.0
QGIS_PYTHON_MIN=3.7
QGIS_PROJ_MIN=7.2.0
QGIS_GEOS_MIN=3.9
QGIS_GDAL_MIN=3.2.0

# 目标平台
TARGET_OS=Kylin-Server-V10-Halberd
TARGET_ARCH=x86_64
TARGET_CPU=Hygon-C86-3G
TARGET_KERNEL=4.19.90-89.11.v2401.ky10
TARGET_UKUI=UKUI

# x86-64 基线：不产生 AVX/AVX2/AVX-512 指令，兼容所有 Hygon C86 / x86_64 v1
# 禁止使用 -march=native；也不要使用 -mavx* / -march=znver*
ISA_CFLAGS="-march=x86-64 -mtune=generic -O2 -pipe"
ISA_CXXFLAGS="-march=x86-64 -mtune=generic -O2 -pipe"
ISA_POLICY=x86-64-baseline
ALLOW_AVX512=false
ALLOW_AVX2_WARN=true

# 构建参数（可被环境变量覆盖）
# 默认 4；workflow_dispatch 的 build_jobs 输入 / 外部环境变量可覆盖
# （本文件被 source 时是 set -a，写死会吞掉 workflow 传入的 QGIS_BUILD_JOBS）
QGIS_BUILD_JOBS=${QGIS_BUILD_JOBS:-4}
MIN_FREE_GB=40
BUILD_WITH_QT6=OFF
WITH_3D=ON
WITH_BINDINGS=ON
WITH_DESKTOP=ON
WITH_SERVER=OFF

# 三层验证契约（见 docs/STAGES.md）
STAGE_A=SOURCE_BUILD
STAGE_B=RPM_BUILD
STAGE_B2=CONTAINER_RUNTIME
STAGE_C=TARGET_VM_RUNTIME
STAGE_D=C86_HARDWARE_RUNTIME

# ---- 原生 self-hosted 构建（不覆盖系统库，统一安装到独立前缀） ----
# 依赖版本与上游地址集中在 scripts/deps/versions.env，由 20-build-deps.sh 读取
DEPS_VERSIONS_FILE=scripts/deps/versions.env
DEPS_STAMP_DIR=.deps-stamps
QGIS_CMAKE_GENERATOR=Ninja
# 依赖缓存目录由 workflow 注入（runner.workspace 下的持久化目录）；
# 本地回退到仓库 .cache/，避免污染 /usr 与系统 Qt/PROJ/GEOS/GDAL
DEPS_PREFIX_DEFAULT=.cache/qgis-334-deps
CACHE_DIR_DEFAULT=.cache/qgis-334-src
