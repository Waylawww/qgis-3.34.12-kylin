# Assimp 6.0.5 · Kylin V10 (Lance) / aarch64 / Phytium D2000-8E8C 原生构建参数
# B 设备专用：由 .github/workflows/assimp-b-arm64.yml 通过 BUILD_ENV 注入。
# 源码与补丁同 A 设备（libs/assimp-10.19 = v6.0.5 + assimp-6.0.5-kylin.patch），
# 仅覆盖目标平台、ISA 与运行库策略。

ASSIMP_VERSION=6.0.5
ASSIMP_VERSION_MAJOR=6
ASSIMP_TAG=v6.0.5
ASSIMP_UPSTREAM_REPO=https://github.com/assimp/assimp
ASSIMP_GIT_COMMIT=392a658f9c271be965271f45e7521a1b80ea4392
ASSIMP_PATCH_REL=patches/assimp-6.0.5-kylin.patch
ASSIMP_PATCH_SHA256=7355dcd16290a487c0b0bd368b942d8ec440295f902354554885389e2b3e203c

# RPM 内安装前缀，与 A 设备保持一致
ASSIMP_INSTALL_PREFIX=/opt/assimp-6.0.5

ASSIMP_BUILD_TESTS=ON
ASSIMP_BUILD_TOOLS=ON
ASSIMP_BUILD_SAMPLES=OFF
ASSIMP_WARNINGS_AS_ERRORS=OFF
ASSIMP_BUILD_SHARED=ON
ASSIMP_MIN_CMAKE=3.22.0
ASSIMP_BOOTSTRAP_CMAKE_VERSION=3.28.3

# ---- B 设备平台参数（与 config/build-b-arm64.env 对齐）----
TARGET_OS=Kylin-Server-V10-Lance
TARGET_ARCH=aarch64
TARGET_CPU=Phytium-D2000-8E8C
ISA_CFLAGS="-march=armv8-a -O2 -pipe"
ISA_CXXFLAGS="-march=armv8-a -O2 -pipe"
ISA_POLICY=aarch64-armv8a-baseline
# B 设备使用系统 GCC7 全链编译，不打包私有 libstdc++（与 QGIS B 一致）
REQUIRE_GCC11=false
