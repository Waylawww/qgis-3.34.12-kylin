# ============================================================================
# 【必须确认】银河麒麟 V10 (Halberd) 环境参数
# 用法：本文件是模板。请在真实麒麟 V10 容器中运行
#       python3 scripts/probe-kylin.py --write
#   由脚本生成 config/kylin.confirmed.env（本机不入库）。
#   未经确认的字段一律保持 __UNCONFIRMED__，preflight 会拒绝继续。
# 严禁凭猜测填写软件源地址、包名或版本号。
# ============================================================================

# --- 1. 容器基础镜像 ---------------------------------------------------------
# 官方是否提供公开可拉取的 Kylin V10 x86_64 容器镜像，需要确认。
# 若没有：用 docker/Dockerfile.bootstrap + scripts/bootstrap/10-make-rootfs.sh
#         从官方 ISO 生成 rootfs 后推送到私有仓库，再填这里。
# 必须是 RPM/dnf 体系、glibc 与目标机一致的 Kylin V10 镜像，不得是 Ubuntu。
KYLIN_BASE_IMAGE=__UNCONFIRMED__
# 强烈建议锁定 digest，保证可复现（形如 sha256:...）
KYLIN_BASE_IMAGE_DIGEST=__UNCONFIRMED__
# 若为私有仓库，Credentials 走 GitHub Secrets / GHCR
KYLIN_REGISTRY=__UNCONFIRMED__
KYLIN_REGISTRY_USERNAME=__UNCONFIRMED__

# --- 2. 软件源 ---------------------------------------------------------------
# 目标机 /etc/yum.repos.d/*.repo 的内容来源。留空表示基础镜像内已正确配置。
# 需确认：baseurl / gpgkey / gpgcheck / repo id / 是否含 EPOL、Update、PowerTools
KYLIN_REPO_FILE_URL=__UNCONFIRMED__
# 逗号分隔的额外 .repo URL（例如为补齐 Qt>=5.14、PROJ>=7.2 而自建的依赖叠加源）
KYLIN_EXTRA_REPO_URLS=
KYLIN_REPO_GPGCHECK=__UNCONFIRMED__
KYLIN_REPO_IDS=__UNCONFIRMED__

# --- 3. 系统事实（由 probe 自动采集） ---------------------------------------
KYLIN_OS_ID=__UNCONFIRMED__
KYLIN_OS_VERSION_ID=__UNCONFIRMED__
KYLIN_OS_PRETTY_NAME=__UNCONFIRMED__
KYLIN_KERNEL=__UNCONFIRMED__
KYLIN_GLIBC=__UNCONFIRMED__
KYLIN_GCC=__UNCONFIRMED__
KYLIN_RPM_VERSION=__UNCONFIRMED__
KYLIN_PACKAGE_MANAGER=__UNCONFIRMED__
KYLIN_LIBDIR=__UNCONFIRMED__
KYLIN_PYTHON3_BIN=__UNCONFIRMED__
KYLIN_PYTHON3_VERSION=__UNCONFIRMED__
KYLIN_PYTHON3_SITEARCH=__UNCONFIRMED__
KYLIN_MACRO_LIBDIR=__UNCONFIRMED__
KYLIN_MACRO_SMP_MFLAGS=__UNCONFIRMED__
KYLIN_DIST_TAG=__UNCONFIRMED__

# --- 4. QEMU/KVM 目标系统验证镜像 -------------------------------------------
# 必须是与目标机同版本的 Kylin V10 x86_64 qcow2，且已装 cloud-init + sshd。
# 没有该镜像时，STAGE_C 明确标记 UNVERIFIED，不得宣称"目标系统运行成功"。
KYLIN_QCOW2_URL=
KYLIN_QCOW2_SHA256=
KYLIN_QCOW2_FORMAT=qcow2
KYLIN_VM_SSH_USER=qgis-ci
KYLIN_VM_SSH_PASSWORD=__UNCONFIRMED__
KYLIN_VM_HAS_CLOUDINIT=__UNCONFIRMED__
KYLIN_VM_IMAGE_HAS_UKUI=__UNCONFIRMED__
KYLIN_XVFB_PACKAGE=__UNCONFIRMED__
KYLIN_CLOUDINIT_PACKAGE=__UNCONFIRMED__
VM_RAM_MB=4096
VM_CPUS=2
VM_BOOT_TIMEOUT_SEC=900
VM_SSH_PORT=2222
# GitHub 托管 runner 可能没有 /dev/kvm；为空时脚本自动降级为 TCG 软件模拟
VM_REQUIRE_KVM=false

# --- 5. 目标机 CPU 事实（无法云端验证，需人工确认后填写） -------------------
# 在真实海光 C86-3G 上执行 `lscpu`、`gcc -march=native -Q --help=target | grep march`
C86_CPU_MODEL=__UNCONFIRMED__
C86_CPU_FLAGS=__UNCONFIRMED__
C86_GLIBC=__UNCONFIRMED__
C86_UKUI_VERSION=__UNCONFIRMED__
C86_GPU_DRIVER=__UNCONFIRMED__
