# osg2vsg 0.4.0 · Kylin V10 (Halberd) / x86_64 / Hygon C86 原生构建
OSG2VSG_VERSION=0.4.0
OSG2VSG_TAG=v0.4.0
OSG2VSG_REPO=https://github.com/vsg-dev/osg2vsg
OSG2VSG_COMMIT=8494fc6cb25d8d74cc41a8737f77e8a639ea39fb

# 依赖：OpenSceneGraph + VulkanSceneGraph(>=1.1.13) + Vulkan loader/headers
VSG_VERSION=1.1.13
VSG_TAG=v1.1.13
VSG_REPO=https://github.com/vsg-dev/VulkanSceneGraph
VSG_COMMIT=05bb15b50fbfe1056f9d8d2ef8a83060e68ad66d

OSG_VERSION=3.6.5
OSG_TAG=OpenSceneGraph-3.6.5
OSG_REPO=https://github.com/openscenegraph/OpenSceneGraph
OSG_COMMIT=a827840baf0786d72e11ac16d5338a4ee25779db

# 系统 vulkan-headers 1.1.92 与 VSG 1.1.13 的兼容层冲突，改用 1.1.106 头文件，
# 链接仍用系统 vulkan-loader。
VULKAN_HEADERS_COMMIT=08cbb5458f692d4778806775f65eb3dc642ddbbf

OSG2VSG_INSTALL_PREFIX=/opt/osg2vsg-0.4.0
VSG_INSTALL_PREFIX=/opt/vsg-1.1.13
OSG_INSTALL_PREFIX=/opt/osg-3.6.5

OSG2VSG_BUILD_JOBS_DEFAULT=4
OSG2VSG_BUILD_WERROR=OFF
OSG2VSG_MIN_CMAKE=3.16
