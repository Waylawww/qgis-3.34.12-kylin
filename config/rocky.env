# Rocky 1.0.2 (ABI 46) · Kylin V10 / x86_64 / Hygon C86 原生构建
# 与 QGIS / Assimp / glslang / osg2vsg 共用同一台 self-hosted runner。

ROCKY_VERSION=1.0.2
ROCKY_VERSION_ABI=46
ROCKY_REPO=https://github.com/pelicanmapping/rocky
ROCKY_COMMIT=0ae35e21851dd66286fc923d4e4b2557f43e9eff
ROCKY_INSTALL_PREFIX=/opt/rocky-1.0.2

# 上游要求 Vulkan SDK >= 1.3.261；使用固定头文件 + 系统 vulkan-loader
VULKAN_HEADERS_COMMIT=07ff4233bc69e573ae0a6b4b48ad16451ac4e37f
VULKAN_HEADERS_LABEL=1.3.268

# 轻量依赖固定 tag（header-only / 小库，在 runner 私有前缀安装）
GLM_TAG=1.0.1
SPDLOG_TAG=v1.12.0
NLOHMANN_JSON_TAG=v3.11.3
CPP_HTTPLIB_TAG=v0.14.3
ENTT_TAG=v3.13.2

# 关闭不需要的重型/可选模块，保留 VSG 渲染器、GDAL、MBTiles、HTTPS
ROCKY_RENDERER_VSG=ON
ROCKY_SUPPORTS_GDAL=ON
ROCKY_SUPPORTS_MBTILES=ON
ROCKY_SUPPORTS_HTTPS=ON
ROCKY_SUPPORTS_HTTPLIB=ON
ROCKY_SUPPORTS_CURL=OFF
ROCKY_SUPPORTS_IMGUI=OFF
ROCKY_SUPPORTS_QT=OFF
ROCKY_SUPPORTS_AZURE=OFF
ROCKY_SUPPORTS_BING=OFF
ROCKY_BUILD_SHARED=ON

ROCKY_MIN_CMAKE=3.21.0
