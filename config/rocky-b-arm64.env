# Rocky 1.0.2 (ABI 46) · Kylin V10 (Lance) / aarch64 / Hi1616 原生构建参数
# B 设备专用：由 .github/workflows/rocky-b-arm64.yml 通过 BUILD_ENV 注入。
# 版本/commit 与 A 设备一致；覆盖平台/ISA/GCC，并把 vsg/glslang/GDAL 指向
# B 设备已产出的自包含依赖前缀（A 设备是 /opt 系统安装，B 设备是 work 目录）。

ROCKY_VERSION=1.0.2
ROCKY_VERSION_ABI=46
ROCKY_REPO=https://github.com/pelicanmapping/rocky
ROCKY_COMMIT=0ae35e21851dd66286fc923d4e4b2557f43e9eff
ROCKY_INSTALL_PREFIX=/opt/rocky-1.0.2

VULKAN_HEADERS_COMMIT=07ff4233bc69e573ae0a6b4b48ad16451ac4e37f
VULKAN_HEADERS_LABEL=1.3.268

GLM_TAG=1.0.1
SPDLOG_TAG=v1.12.0
NLOHMANN_JSON_TAG=v3.11.3
CPP_HTTPLIB_TAG=v0.18.0
ENTT_TAG=v3.13.2

ROCKY_RENDERER_VSG=ON
ROCKY_SUPPORTS_GDAL=ON
ROCKY_SUPPORTS_MBTILES=ON
ROCKY_SUPPORTS_HTTPS=ON
ROCKY_SUPPORTS_HTTPLIB=ON
ROCKY_SUPPORTS_CURL=OFF
ROCKY_SUPPORTS_IMGUI=OFF
ROCKY_SUPPORTS_QT=OFF
ROCKY_SUPPORTS_AZURE=OFF
ROCKY_SUPPORTS_BING=OFF
ROCKY_BUILD_SHARED=ON
ROCKY_MIN_CMAKE=3.21.0

# ---- B 设备平台参数 ----
TARGET_OS=Kylin-Server-V10-Lance
TARGET_ARCH=aarch64
TARGET_CPU=Hi1616-64bit
ISA_CFLAGS="-march=armv8-a -O2 -pipe"
ISA_CXXFLAGS="-march=armv8-a -O2 -pipe"
ISA_POLICY=aarch64-armv8a-baseline
# B 设备使用系统 GCC7 全链编译，不打包私有 libstdc++
REQUIRE_GCC11=false

# ---- B 设备已产出的依赖前缀（cmake config + 运行库）----
# vsg 1.1.13 由 osg2vsg B 设备构建时安装到此前缀（已含 GCC7 模板修复）
B_VSG_PREFIX=/opt/actions-runner/_work/qgis-3.34.12-kylin/_b-osg2vsg-040-work/deps/vsg-1.1.13
# glslang 16.1.0 B 设备构建的 local-install 前缀
B_GLSLANG_PREFIX=/opt/actions-runner/_work/qgis-3.34.12-kylin/_b-glslang-1610-work/local-install/opt/glslang-16.1.0
