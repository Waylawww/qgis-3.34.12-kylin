# vsgXchange 1.1.9 · Kylin V10 (Lance) / aarch64 / Hi1616 原生构建参数
# B 设备专用：由 .github/workflows/vsgxchange-b-arm64.yml 通过 BUILD_ENV 注入。
# 版本/commit 与 A 设备一致；依赖前缀指向 B 设备已产出的自包含安装树。

VSGXCHANGE_VERSION=1.1.9
VSGXCHANGE_SOVERSION=2
VSGXCHANGE_REPO=https://github.com/vsg-dev/vsgXchange
VSGXCHANGE_COMMIT=76ee4f8fdaafc9c5b5164403b2393c2c170b69e2
VSGXCHANGE_INSTALL_PREFIX=/opt/vsgxchange-1.1.9

# B 设备依赖前缀（用 B_ 前缀避免被 config/vsgxchange.env 覆盖）
B_OSG2VSG_PREFIX=/opt/actions-runner/_work/qgis-3.34.12-kylin/_b-osg2vsg-040-work/local-install/opt/osg2vsg-0.4.0
B_GLSLANG_PREFIX=/opt/actions-runner/_work/qgis-3.34.12-kylin/_b-glslang-1610-work/local-install/opt/glslang-16.1.0
B_ASSIMP_PREFIX=/opt/actions-runner/_work/qgis-3.34.12-kylin/_b-assimp-605-work/local-install/opt/assimp-6.0.5

VSGXCHANGE_BUILD_SHARED=ON
VSGXCHANGE_ENABLE_OSG=ON
VSGXCHANGE_ENABLE_ASSIMP=ON
VSGXCHANGE_ENABLE_GDAL=ON
VSGXCHANGE_ENABLE_CURL=OFF
VSGXCHANGE_ENABLE_FREETYPE=ON
VSGXCHANGE_ENABLE_DRACO=OFF
VSGXCHANGE_ENABLE_KTX=OFF
VSGXCHANGE_ENABLE_OPENEXR=OFF

VSGXCHANGE_MIN_CMAKE=3.16

# ---- B 设备平台参数 ----
TARGET_OS=Kylin-Server-V10-Lance
TARGET_ARCH=aarch64
TARGET_CPU=Hi1616-64bit
ISA_CFLAGS="-march=armv8-a -O2 -pipe"
ISA_CXXFLAGS="-march=armv8-a -O2 -pipe"
ISA_POLICY=aarch64-armv8a-baseline
REQUIRE_GCC11=false
