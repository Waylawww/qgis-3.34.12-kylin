# glslang 16.1.0 (main-tot) · Kylin V10 (Lance) / aarch64 / Phytium D2000-8E8C
# B 设备专用：由 .github/workflows/glslang-b-arm64.yml 通过 BUILD_ENV 注入。
# 源码与 External 依赖 commit 同 A 设备，仅覆盖目标平台、ISA 与运行库策略。

GLSLANG_VERSION=16.1.0
GLSLANG_TAG=main-tot
GLSLANG_REPO=https://github.com/KhronosGroup/glslang
GLSLANG_COMMIT=b937eae5e2ae1e29efe8f8775feaa434239806d2

# GCC7 兼容补丁：Kylin V10 aarch64 系统 GCC 7.3.0 无 <filesystem>，
# 改用 <experimental/filesystem>（链接 -lstdc++fs）。A 设备不使用。
GLSLANG_PATCH_REL=patches/glslang-16.1.0-kylin-gcc7-fs.patch
GLSLANG_PATCH_SHA256=3aa25c14cb588083bdfdc46d37ea8dd3dabe4b2fbc7ceec23c9843b78568418d
# 补丁用 realpath 替代 std::filesystem::absolute，不依赖任何 filesystem 库。

SPIRV_TOOLS_COMMIT=5f4b62de998d161ee01e6f7706da2d855f8fcdc8
SPIRV_HEADERS_COMMIT=babee77020ff82b571d723ce2c0262e2ec0ee3f1
GOOGLETEST_COMMIT=f8d7d77c06936315286eb55f8de22cd23c188571

GLSLANG_INSTALL_PREFIX=/opt/glslang-16.1.0

GLSLANG_BUILD_TESTS=ON
GLSLANG_BUILD_BINARIES=ON
GLSLANG_ENABLE_OPT=OFF
GLSLANG_ENABLE_HLSL=ON
GLSLANG_BUILD_SHARED=ON
GLSLANG_BUILD_WERROR=OFF
GLSLANG_ENABLE_PCH=OFF
GLSLANG_MIN_CMAKE=3.29.0
GLSLANG_BOOTSTRAP_CMAKE_VERSION=3.31.6

# ---- B 设备平台参数（与 config/build-b-arm64.env 对齐）----
TARGET_OS=Kylin-Server-V10-Lance
TARGET_ARCH=aarch64
TARGET_CPU=Phytium-D2000-8E8C
ISA_CFLAGS="-march=armv8-a -O2 -pipe"
ISA_CXXFLAGS="-march=armv8-a -O2 -pipe"
ISA_POLICY=aarch64-armv8a-baseline
# B 设备使用系统 GCC7 全链编译，不打包私有 libstdc++（与 QGIS/Assimp B 一致）
REQUIRE_GCC11=false
