# VulkanSceneGraph 1.1.13 · Kylin V10 (Lance) / aarch64 / Hi1616 原生构建参数
# B 设备专用：由 .github/workflows/vsg-b-arm64.yml 通过 BUILD_ENV 注入。
# 版本/commit 与 A 设备一致；覆盖平台/ISA/GCC，并指向 B 设备 glslang 前缀。

VSG_VERSION=1.1.13
VSG_SOVERSION=15
VSG_REPO=https://github.com/vsg-dev/VulkanSceneGraph
VSG_COMMIT=05bb15b50fbfe1056f9d8d2ef8a83060e68ad66d
VSG_INSTALL_PREFIX=/opt/vsg-1.1.13

VULKAN_HEADERS_COMMIT=881bbb347a08d1b5aa77f61a52a30b506de9f2bf
VULKAN_HEADERS_LABEL=1.2.131

# B 设备 glslang 16.1.0 本地安装前缀（含 cmake config + lib64 运行库）
GLSLANG_PREFIX=/opt/actions-runner/_work/qgis-3.34.12-kylin/_b-glslang-1610-work/local-install/opt/glslang-16.1.0
VSG_SUPPORTS_ShaderCompiler=ON
VSG_SUPPORTS_ShaderOptimizer=OFF
VSG_SUPPORTS_Windowing=ON

VSG_MIN_CMAKE=3.16

# ---- B 设备平台参数 ----
TARGET_OS=Kylin-Server-V10-Lance
TARGET_ARCH=aarch64
TARGET_CPU=Hi1616-64bit
ISA_CFLAGS="-march=armv8-a -O2 -pipe"
ISA_CXXFLAGS="-march=armv8-a -O2 -pipe"
ISA_POLICY=aarch64-armv8a-baseline
# B 设备使用系统 GCC7 全链编译，不打包私有 libstdc++
REQUIRE_GCC11=false
# GCC7 aarch64 下 VSG 的 ref_ptr<Duplicate> inline 构造未实例化，需显式实例化
VSG_PATCH_GCC7_DUP=true
