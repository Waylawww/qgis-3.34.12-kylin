# ============================================================================
# B 设备：Kylin V10 (Lance) / aarch64 / Phytium D2000-8E8C
# 复用 A 设备已核验的 QGIS 版本与依赖下限，只覆盖目标平台与 ISA 参数。
# ============================================================================

QGIS_VERSION=3.34.12
QGIS_RELEASE_NAME=Prizren
QGIS_GIT_REPO=https://github.com/qgis/QGIS.git
QGIS_GIT_TAG=final-3_34_12
QGIS_GIT_COMMIT=eeb6af363865e463b8f058b7d79fd5378c4bf065
QGIS_SOURCE_DIR_NAME=qgis-3.34.12
QGIS_SOURCE_TARBALL=qgis-3.34.12.tar.bz2
QGIS_RELEASE_TAG_FOR_GITHUB=v3.34.12-kylin10-aarch64

QGIS_CMAKE_MIN=3.12.0
QGIS_FLEX_MIN=2.6.0
QGIS_QT5_MIN=5.14.0
QGIS_PYTHON_MIN=3.7
QGIS_PROJ_MIN=7.2.0
QGIS_GEOS_MIN=3.9
QGIS_GDAL_MIN=3.2.0

TARGET_OS=Kylin-Server-V10-Lance
TARGET_ARCH=aarch64
TARGET_CPU=Phytium-D2000-8E8C
TARGET_KERNEL=4.19.90-52.22.v2207.ky10.aarch64
TARGET_UKUI=UKUI

# ARMv8-A 基线，不使用 -march=native；AVX 相关门禁在 aarch64 下自动跳过。
ISA_CFLAGS="-march=armv8-a -O2 -pipe"
ISA_CXXFLAGS="-march=armv8-a -O2 -pipe"
ISA_POLICY=aarch64-armv8a-baseline
ALLOW_AVX512=false
ALLOW_AVX2_WARN=false

QGIS_BUILD_JOBS=${QGIS_BUILD_JOBS:-4}
MIN_FREE_GB=40
BUILD_WITH_QT6=OFF
WITH_3D=ON
WITH_BINDINGS=ON
WITH_DESKTOP=ON
WITH_SERVER=OFF

STAGE_A=SOURCE_BUILD
STAGE_B=RPM_BUILD
STAGE_B2=CONTAINER_RUNTIME
STAGE_C=TARGET_VM_RUNTIME
STAGE_D=ARM64_HARDWARE_RUNTIME

DEPS_VERSIONS_FILE=scripts/deps/versions.env
DEPS_STAMP_DIR=.deps-stamps
QGIS_CMAKE_GENERATOR=Ninja
DEPS_PREFIX_DEFAULT=.cache/qgis-334-deps-aarch64
CACHE_DIR_DEFAULT=.cache/qgis-334-src-aarch64
