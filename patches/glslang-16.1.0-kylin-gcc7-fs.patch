+namespace glslang {
+inline std::string glslangAbsolutePath(const std::string& path) {
+    char resolved[4096];
+    if (realpath(path.c_str(), resolved) != nullptr) return std::string(resolved);
+    return path;
+}
+} // namespace glslang
 
